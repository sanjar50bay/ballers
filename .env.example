# Keep your real .env.local private; never send service_role/secret keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: enable only AFTER configuring Apple in Supabase and testing its OAuth callback.
NEXT_PUBLIC_AUTH_APPLE_ENABLED=false
# VK is not a built-in provider in this SDK. Requires a compatible custom provider.
# Set its identifier only after a verified server-side integration, e.g. custom:vk.
NEXT_PUBLIC_AUTH_VK_PROVIDER=
